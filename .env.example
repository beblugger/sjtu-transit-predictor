# Application
AIRCRAFT_ENVIRONMENT=development
AIRCRAFT_HOST=127.0.0.1
AIRCRAFT_PORT=8000
AIRCRAFT_DATABASE_PATH=./transit.db
AIRCRAFT_EPHEMERIS_PATH=~/.cache/sjtu-transit/de421.bsp

# Satellite prediction
AIRCRAFT_SATELLITE_HOURS=96
AIRCRAFT_SATELLITE_COARSE_STEP_SECONDS=60
AIRCRAFT_SATELLITE_FINE_STEP_SECONDS=0.25
AIRCRAFT_SATELLITE_MAX_TARGETS=0
AIRCRAFT_TLE_REFRESH_SECONDS=7200
# Warning threshold only: old epochs and downloaded snapshots remain usable.
AIRCRAFT_TLE_STALE_SECONDS=21600
AIRCRAFT_CELESTRAK_TIMEOUT_SECONDS=20
AIRCRAFT_CELESTRAK_ACTIVE_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=json
AIRCRAFT_COMMUNITY_ORBIT_URL=https://raw.githubusercontent.com/satvisorcom/satvisor-data/master/celestrak/json/active.json

# Campus scan
AIRCRAFT_CAMPUS_GRID_METERS=100
AIRCRAFT_CAMPUS_REFINE_METERS=25

# Weather (Open-Meteo, no key required)
AIRCRAFT_WEATHER_REFRESH_SECONDS=900
AIRCRAFT_WEATHER_ENSEMBLE_REFRESH_SECONDS=10800
AIRCRAFT_WEATHER_STALE_SECONDS=1800
AIRCRAFT_WEATHER_ENSEMBLE_STALE_SECONDS=43200

# Aircraft
AIRCRAFT_ADS_PROVIDER=none
AIRCRAFT_AIRCRAFT_QUERY_RADIUS_KM=100
AIRCRAFT_AIRCRAFT_POLL_SECONDS=5
AIRCRAFT_AIRCRAFT_HORIZON_SECONDS=600

# VariFlight DataWorks Radar ADS-B V2 trial credentials.
# Ask dataworks@variflight.com for access. Never commit real values.
AIRCRAFT_VARIFLIGHT_APP_ID=
AIRCRAFT_VARIFLIGHT_APP_SECURITY=
AIRCRAFT_VARIFLIGHT_RADAR_URL=https://open-al.variflight.com/api/radarv2

# Optional Aviation MCP per-tail enrichment.
AIRCRAFT_VARIFLIGHT_MCP_URL=https://mcp.variflight.com/api/v1/mcp/data
AIRCRAFT_VARIFLIGHT_API_KEY=
