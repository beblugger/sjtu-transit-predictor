# Static export
TRANSIT_DATABASE_PATH=./transit.db
TRANSIT_EPHEMERIS_PATH=~/.cache/sjtu-transit/de421.bsp

# Satellite prediction
TRANSIT_SATELLITE_HOURS=96
TRANSIT_SATELLITE_COARSE_STEP_SECONDS=60
TRANSIT_SATELLITE_MAX_TARGETS=0
TRANSIT_TLE_REFRESH_SECONDS=7200
# Warning threshold only: old epochs and downloaded snapshots remain usable.
TRANSIT_TLE_STALE_SECONDS=21600
TRANSIT_CELESTRAK_TIMEOUT_SECONDS=20
TRANSIT_CELESTRAK_ACTIVE_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=json
TRANSIT_CELESTRAK_UPDATE_URL=https://celestrak.org/NORAD/elements/
TRANSIT_COMMUNITY_ORBIT_URL=https://raw.githubusercontent.com/satvisorcom/satvisor-data/master/celestrak/json/active.json

# Campus scan
TRANSIT_CAMPUS_GRID_METERS=100
TRANSIT_CAMPUS_REFINE_METERS=25

# Weather (Open-Meteo, no key required)
TRANSIT_WEATHER_REFRESH_SECONDS=900
TRANSIT_WEATHER_ENSEMBLE_REFRESH_SECONDS=10800
TRANSIT_WEATHER_STALE_SECONDS=1800
TRANSIT_WEATHER_ENSEMBLE_STALE_SECONDS=43200
